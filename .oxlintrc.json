{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true,
    "worker": true
  },
  "globals": {
    "chrome": "readonly",
    "confetti": "readonly",
    "WallyLayout": "readonly",
    "WallyGlitch": "readonly",
    "WallyBanc": "readonly",
    "OverlayAdmin": "readonly"
  },
  "rules": {
    "no-unused-vars": "off"
  }
}
