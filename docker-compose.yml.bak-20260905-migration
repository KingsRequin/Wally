networks:
  wally-net:
    driver: bridge
  firecrawl-shared:
    external: true

services:
  init-perms:
    image: alpine:3.19
    container_name: wally-init-perms
    user: "0:0"
    volumes:
      - ./data:/data
      - ./logs:/logs
      - ./bot/persona:/persona
      - ./.env:/dotenv
      - ./config.yaml:/config.yaml
    command: sh -c "chown -R 1000:1000 /data /logs /persona && chmod -R 775 /data /logs && chown 1000:1000 /dotenv /config.yaml"
    restart: "no"

  wally:
    build:
      context: .
      args:
        GIT_HASH: ${GIT_HASH:-unknown}
        BUILD_DATE: ${BUILD_DATE:-unknown}
    container_name: wally-bot
    # Laisse le temps de terminer les écritures en cours avant le SIGKILL
    # (le défaut de 10 s coupait le process en pleine écriture de log).
    stop_grace_period: 30s
    user: "1000:1000"
    group_add:
      - "996"
    networks:
      - wally-net
      - firecrawl-shared
    depends_on:
      init-perms:
        condition: service_completed_successfully
    environment:
      - TZ=Europe/Paris
      - HF_HOME=/app/data/hf-cache   # cache modèle faster-whisper dans le volume persistant ./data (évite le re-download à chaque restart)
    env_file: .env
    ports:
      - "0.0.0.0:8080:8080"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
      - ./config.yaml:/app/config.yaml
      - ./bot/persona:/app/bot/persona
      - ./bot/intelligence/persona/CHANNELS.md:/app/bot/intelligence/persona/CHANNELS.md
      # Les prompts de COGNITION (gate, reasoning, speak_guard, monologue…). Du
      # contenu éditorial, comme ceux de bot/persona/prompts déjà montés au-dessus :
      # les éditer ne devrait pas demander un rebuild. Un restart reste nécessaire,
      # ils sont lus au boot à la construction des services.
      - ./bot/intelligence/persona/prompts:/app/bot/intelligence/persona/prompts:ro
      - ./public-ui:/app/public-ui:ro
      - ./.env:/app/.env
      - ./bot/dashboard/static:/app/bot/dashboard/static:ro
      # Le cache des modèles STT (faster-whisper les tire de HuggingFace). Sans
      # ce volume, il vit dans la couche du conteneur : chaque rebuild le jette,
      # et le premier énoncé du vocal attend un téléchargement de 145 Mo. On le
      # rebuild plusieurs fois par soirée.
      - ./data/hf-cache:/home/wally/.cache/huggingface
      - /var/run/docker.sock:/var/run/docker.sock
      - /opt/stacks/wally-instances:/opt/stacks/wally-instances
      - /usr/bin/docker:/usr/bin/docker:ro
      - /usr/libexec/docker/cli-plugins/docker-compose:/usr/libexec/docker/cli-plugins/docker-compose:ro
    restart: unless-stopped

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: wally-cloudflared
    command: tunnel --no-autoupdate run
    networks:
      - wally-net
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARED_WALLY_TOKEN}
      # Adresse du serveur de métriques, d'où `/ready` est servi. Fixée
      # EXPLICITEMENT : sans elle, cloudflared essaie 20241 à 20245 puis se
      # rabat sur un port AU HASARD, et le healthcheck n'a plus d'adresse à
      # interroger. Sur la boucle locale : jamais exposée hors du conteneur.
      - TUNNEL_METRICS=127.0.0.1:20241
    depends_on:
      - wally
    restart: unless-stopped
    healthcheck:
      # `tunnel info` exige l'ID du tunnel en argument. Le healthcheck d'origine
      # l'appelait sans, et échouait donc à CHAQUE passage : 2751 échecs
      # consécutifs constatés le 2026-08-20, pendant que le tunnel servait
      # normalement ses 4 connexions. Un voyant rouge en permanence ne peut plus
      # signaler la moindre panne réelle — c'est pire que pas de voyant du tout.
      # `tunnel ready` interroge /ready et rend le code de sortie correspondant.
      # C'est le binaire lui-même : seul exécutable de cette image distroless,
      # qui n'a ni shell, ni curl, ni wget.
      test: ["CMD", "cloudflared", "tunnel", "ready"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
